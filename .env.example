# Pickeed – Umgebungsvariablen (Vorlage). Kopieren nach .env und Werte setzen.
# Echte Werte (Passwörter, Schlüssel) niemals committen.

# Öffentliche Basis-URL ohne abschliessenden Schrägstrich
SITE_URL=http://localhost:3000

# PostgreSQL 16 (lokal: docker compose up -d db)
DATABASE_URL=postgres://pickeed:pickeed@localhost:5432/pickeed
# Separate Datenbank für Integrationstests (wird von den Tests geleert)
TEST_DATABASE_URL=postgres://pickeed:pickeed@localhost:5432/pickeed_test

# Interne Designsystem-Seite /design in Produktion freischalten (Standard: aus)
ENABLE_DESIGN_PREVIEW=false
